{
  "name": "adsb",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "nodemon --exec \"node -r esbuild-register ./src/index.ts\" -e .ts",
    "lint": "tsc --noEmit && TIMING=1 eslint \"src/**/*.ts*\"",
    "start": "node -r esbuild-register ./src/index.ts",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "jest-presets/jest/node"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.9",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.33.0",
    "eslint-config-custom-server": "*",
    "jest": "^30.0.5",
    "jest-presets": "*",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "tsconfig": "*",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "axios": "^1.11.0",
    "database": "*",
    "prettier": "^3.6.2",
    "supertest": "^7.1.0",
    "turbo": "^2.5.6",
    "xmlbuilder2": "^3.1.1"
  }
}
