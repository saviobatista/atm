{
  "name": "receiver",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "nodemon --exec \"node -r esbuild-register ./src/index.ts\" -e .ts",
    "lint": "tsc --noEmit && TIMING=1 eslint \"src/**/*.ts*\"",
    "start": "node -r esbuild-register ./src/index.ts",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "jest-presets/jest/node"
  },
  "dependencies": {
    "@maphubs/tokml": "^0.6.1",
    "amqplib": "^0.10.8",
    "axios": "^1.11.0",
    "logger": "*",
    "morgan": "^1.10.1",
    "mssql": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.1.0",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.9",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.33.0",
    "eslint-config-custom-server": "*",
    "jest": "^30.0.5",
    "jest-presets": "*",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "tsconfig": "*",
    "typescript": "^5.9.2"
  }
}
