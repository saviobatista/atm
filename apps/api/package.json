{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "nodemon --exec \"node -r esbuild-register ./src/index.ts\" -e .ts",
    "lint": "tsc --noEmit && TIMING=1 eslint \"src/**/*.ts*\"",
    "start": "node -r esbuild-register ./src/index.ts",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "jest-presets/jest/node"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.5",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "logger": "^0.0.1",
    "morgan": "^1.10.1",
    "mssql": "^11.0.1",
    "supertest": "^7.1.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/logger": "^0.0.5",
    "@types/morgan": "^1.9.10",
    "@types/mssql": "^9.1.7",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.9",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.33.0",
    "eslint-config-custom-server": "*",
    "jest": "^30.0.5",
    "jest-presets": "*",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "tsconfig": "*",
    "typescript": "^5.9.2"
  }
}
